# Environment Variables — Example values for local development and CI
DB_URL=jdbc:postgresql://localhost:5432/clair_core
DB_USERNAME=postgres
DB_PASSWORD=admin

# SMTP Configuration (Resend verified domain)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=your_resend_api_key
SMTP_FROM=noreply@example.com
# Transport flags: real providers use auth + SSL; Mailpit (local profile) uses neither
SMTP_AUTH=true
SMTP_SSL=true
SMTP_STARTTLS=false

# JWT Configuration (test secrets)
JWT_SECRET=test_super_secret_jwt_key_that_is_at_least_32_characters_long
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=admin

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Server Port
PORT=49220

# Google OAuth 2.0 Configuration (test/example values)
# Primary client id used for /google/authorize (must be a single client id).
GOOGLE_OAUTH_CLIENT_ID=123456789-test_example.apps.googleusercontent.com
# Allowed audiences for verifying idToken (web + mobile). Comma-separated.
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=123456789-test_example.apps.googleusercontent.com,123456789-test_example_mobile.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=test_example_secret
GOOGLE_REDIRECT_URI=http://localhost:49220/api/v1/auth/google/callback

# Frontend URL for post-login redirects
FRONTEND_URL=http://localhost:4200

# Stripe Configuration (test/example keys)
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_PRIVATE_KEY=sk_test_12345678901234567890abcdef
STRIPE_PUBLIC_KEY=pk_test_12345678901234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_test_12345678901234567890abcdef

# OneSignal Configuration
ONESIGNAL_API_URL=https://onesignal.com/api/v1/notifications
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_FRONTEND_URL=http://localhost:4200


# Factory inventory (optional). CSV columns: serial_number,hardware_id,api_key,name
DEVICE_PROVISIONING_IMPORT_PATH=
# Demo profile export (contains API keys; not for version control)
DEVICE_PROVISIONING_EXPORT_PATH=provisioned-devices.csv

# Flyway: keep false normally. Enable only for the first adoption of an existing phase-7 schema.
FLYWAY_BASELINE_ON_MIGRATE=false
# Timezone originally used to store legacy created_at/updated_at wall-clock values.
# Confirm it before adopting Flyway; use America/Lima if that was the writer's timezone.
LEGACY_AUDIT_ZONE=UTC
